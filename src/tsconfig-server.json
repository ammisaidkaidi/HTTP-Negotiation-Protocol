{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "client/**/*.ts",
    "**/*.test.ts"
  ]
}
