{
  "name": "http-negotiation-protocol",
  "version": "1.12.0",
  "description": "A minimal TypeScript HTTP request-negotiation protocol with client services and external callbacks.",
  "type": "module",
  "license": "MIT",
  "author": "ammisaidkaidi",
  "homepage": "https://github.com/ammisaidkaidi/HTTP-Negotiation-Protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammisaidkaidi/HTTP-Negotiation-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/ammisaidkaidi/HTTP-Negotiation-Protocol/issues"
  },
  "keywords": [
    "http",
    "negotiation",
    "protocol",
    "typescript",
    "webhook",
    "callback"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "esbuild src/client/index.ts --bundle --platform=browser --format=esm --target=es2022 --tsconfig=src/tsconfig-client.json --outfile=dist/client.js",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node20 --tsconfig=src/tsconfig-server.json --outfile=dist/server.js",
    "build:bundles": "npm run build:client && npm run build:server",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "tsx examples/demo.ts",
    "dev": "tsx examples/demo.ts",
    "demo": "tsx examples/demo.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "demo:express": "tsx examples/express.ts",
    "demo:web": "tsx demo/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "express": "^5.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
